# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — never commit (FCM service account, APNs key, env-based secrets).
# NOTE: android/app/google-services.json and ios/Runner/GoogleService-Info.plist
# are client config meant to ship with the app and are intentionally NOT ignored.
*.p8
# Leading * so project-prefixed names match (e.g. aurivo-firebase-adminsdk-xxx.json)
**/*firebase-adminsdk*.json
**/*service-account*.json
.env
.env.*
supabase/.env
supabase/.env.*
# Keep committed env templates trackable.
!.env.example
!.env.sample
!**/.env.example
!**/.env.sample
